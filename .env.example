# Application Environment
NODE_ENV=development

# Telegram Bot Configuration (Required for standalone Telegram Bot daemon)
# Obtain token from @BotFather and numeric ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Storage & Persistence Paths
DATABASE_PATH=./data/app.sqlite
WHATSAPP_AUTH_DIR=./data/whatsapp-sessions
TEMP_UPLOAD_DIR=./data/tmp

# Logging & Operational Limits
LOG_LEVEL=info
MAX_CONCURRENT_TASKS=3
TASK_TIMEOUT_MS=120000
MAX_UPLOAD_SIZE_MB=20

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Ubuntu Live Video Call Streaming Engine (Optional — defaults to /dev/video0 and 127.0.0.1:5555)
VIDEO_ENGINE_V4L2_DEVICE=/dev/video0
VIDEO_ENGINE_ADB_SERIAL=127.0.0.1:5555
VIDEO_ENGINE_AUDIO_SINK=VirtualMic

