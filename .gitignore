# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (never commit secrets)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite databases, WhatsApp authentication sessions, and temporary uploads
/data/*.sqlite
/data/*.sqlite-shm
/data/*.sqlite-wal
/data/*.db
/data/whatsapp-sessions/
/data/tmp/
!/data/.gitkeep

# Playwright verification artifacts
.playwright-cli/
