{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next-dev && next dev",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start",
    "bot:start": "tsx src/app.ts",
    "diagnose:wa": "tsx scripts/diagnose-whatsapp-connection.ts",
    "test:real-whatsapp-voip": "tsx scripts/test-real-whatsapp-voip.ts",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "node -e \"const fs=require('node:fs');for(const d of['.next','.next-dev','tsconfig.tsbuildinfo'])fs.rmSync(d,{recursive:true,force:true});\""
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hiroosy/baileys-lite": "^0.3.7",
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "grammy": "1.46.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "pino": "10.4.0",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
